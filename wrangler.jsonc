/**
 * eng-leadership-toolkit — remote MCP server for marian.coach
 * Served at https://www.marian.coach/mcp (apex-path convention, see /mcp-launch skill)
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "eng-leadership-toolkit",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [
		{ "pattern": "www.marian.coach/mcp*", "zone_name": "marian.coach" },
		{ "pattern": "marian.coach/mcp*", "zone_name": "marian.coach" },
	],
	"migrations": [
		{
			"new_sqlite_classes": ["EngLeadershipToolkit"],
			"tag": "v1",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "EngLeadershipToolkit",
				"name": "MCP_OBJECT",
			},
		],
	},
	"kv_namespaces": [
		{
			"binding": "MCP_SESSIONS",
			"id": "f459fd36614740fcbe313953349d7776",
		},
	],
	"observability": {
		"enabled": true,
	},
	// Cross-probe uptime cron: this Worker watches the sibling mentoring-inquiry-builder
	// (a Worker cannot probe its own routes — Cloudflare self-recursion guard), and the
	// mentoring Worker watches this one's /mcp back. Slack alert on failure only.
	"triggers": {
		"crons": ["*/15 * * * *"],
	},
}
