{
	"name": "ai-engineering-leader-toolkit",
	"version": "1.7.0",
	"private": true,
	"scripts": {
		"deploy": "npm run card:check && wrangler deploy",
		"dev": "wrangler dev",
		"format": "oxfmt --write .",
		"lint:fix": "oxlint --fix",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types",
		"type-check": "tsc --noEmit",
