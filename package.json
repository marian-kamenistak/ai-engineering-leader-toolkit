		"agents": "^0.17.1",
		"posthog-node": "5.51.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"esbuild": "^0.28.2",
		"oxfmt": "^0.56.0",
		"oxlint": "^1.71.0",
		"typescript": "6.0.3",
		"vitest": "^3.2.7",
		"wrangler": "^4.129.0"
	}
}
